{% comment %}
  Кастомный Header drawer (Чистый Vanilla JS + Tailwind)
  Поддержка 3 уровней меню, аккаунта и соцсетей.
{% endcomment %}

<script src="{{ 'custom-header-drawer.js' | asset_url }}" defer="defer"></script>
 
<div id="CustomDrawer" class="custom-drawer is-hidden">
   
  <!-- Затемнение (Overlay) -->
  <div id="CustomDrawerOverlay" class="custom-drawer__overlay">
    <span class="tw:hidden tw:opacity-100">overlay</span>        
  </div>
 
  <!-- Сама панель меню -->
  <aside id="CustomDrawerPanel" class="custom-drawer__panel">
     
    <!-- Шапка драйвера -->
    <div class="custom-drawer__header">
      <span class="custom-drawer__title">Menu</span>
      <button id="CustomDrawerClose" class="custom-drawer__close">
        <svg class="custom-drawer__close-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
 
    <!-- Навигация (Скроллится только здесь) -->
    <nav class="custom-drawer__nav">
      <ul class="custom-drawer__list">
        {%- for link in section.settings.menu.links -%}
          <li class="custom-drawer__item">
            {%- if link.links != blank -%}
               {% comment %} --- 1-й уровень (Выпадашка) ---  {% endcomment %}
              <!-- ВАЖНО: класс group добавлен прямо в HTML, его не должно быть в @apply -->
              <details class="custom-drawer__details group">
                <summary class="custom-drawer__summary">
                  {{ link.title | escape }}
                  <svg class="custom-drawer__arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                </summary>
                <ul class="custom-drawer__sublist">
                  {%- for childlink in link.links -%}
                    <li>
                      {%- if childlink.links == blank -%}
                         {% comment %} --- 2-й уровень (Простая ссылка) ---  {% endcomment %}
                        <a href="{{ childlink.url }}" class="custom-drawer__link--l2">
                          {{ childlink.title | escape }}
                        </a>
                      {%- else -%}
                         {% comment %} --- 2-й уровень (Выпадашка) ---  {% endcomment %}
                        <!-- ВАЖНО: класс group/sub добавлен прямо в HTML, его не должно быть в @apply -->
                        <details class="custom-drawer__subdetails group/sub">
                          <summary class="custom-drawer__subsummary">
                            {{ childlink.title | escape }}
                            <svg class="custom-drawer__subarrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                            </svg>
                          </summary>
                          <ul class="custom-drawer__subsublist">
                            {%- for grandchildlink in childlink.links -%}
                               {% comment %} --- 3-й уровень (Простая ссылка) ---  {% endcomment %}
                              <li>
                                <a href="{{ grandchildlink.url }}" class="custom-drawer__link--l3">
                                  {{ grandchildlink.title | escape }}
                                </a>
                              </li>
                            {%- endfor -%}
                          </ul>
                        </details>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
              </details>
            {%- else -%}
               {% comment %} --- 1-й уровень (Простая ссылка) ---  {% endcomment %}
              <a href="{{ link.url }}" class="custom-drawer__link--l1">
                {{ link.title | escape }}
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>
 
    <!-- Подвал драйвера (Аккаунт + Соцсети) -->
    <div class="custom-drawer__footer">
       
      {%- if shop.customer_accounts_enabled -%}
        <a
          href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
          class="custom-drawer__account-link"
          rel="nofollow"
        >
          <svg class="custom-drawer__account-icon" focusable="false" aria-hidden="true">
            <use href="#profile"></use>
          </svg>
          {%- liquid
            if customer
              echo 'customer.account_fallback' | t
            else
              echo 'customer.log_in' | t
            endif
          -%}
        </a>
      {%- endif -%}            
 
      <!-- СОЦИАЛЬНЫЕ СЕТИ -->
      <div class="custom-drawer__socials">
        {%- if settings.social_instagram_link != blank -%}
          <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener" aria-label="Instagram" class="custom-drawer__social-link">
            <div class="custom-drawer__social-icon">
              <img src="{{ 'instagram.webp' | asset_url }}" alt="Instagram" class="custom-drawer__social-img" loading="lazy" width="60" height="60">
            </div>
          </a>
        {%- endif -%}
 
        {%- if section.settings.social_telegram_link != blank -%}
          <a href="{{ section.settings.social_telegram_link }}" target="_blank" rel="noopener" aria-label="Telegram" class="custom-drawer__social-link">
            <svg class="custom-drawer__social-icon" focusable="false" aria-hidden="true">
              <use href="#telegram"></use>
            </svg>
          </a>
        {%- endif -%}
 
        {%- if settings.social_facebook_link != blank -%}
          <a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener" aria-label="Facebook" class="custom-drawer__social-link">
            <svg class="custom-drawer__social-icon" focusable="false" aria-hidden="true">
              <use href="#facebook"></use>
            </svg>
          </a>
        {%- endif -%}
      </div>
       
    </div>
  </aside>
</div> 
