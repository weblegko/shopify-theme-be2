<style>
  /* ============================================ */
  /* ПАДДИНГИ СЕКЦИИ (rem) - inline стили */
  /* ============================================ */
  .weblegko-collections-padding {
    padding-top: {{ section.settings.padding_top_mobile | default: 3 }}rem !important;
    padding-bottom: {{ section.settings.padding_bottom_mobile | default: 3 }}rem !important;
  }

  @media screen and (min-width: 640px) {
    .weblegko-collections-padding {
      padding-top: {{ section.settings.padding_top_tablet | default: 4 }}rem !important;
      padding-bottom: {{ section.settings.padding_bottom_tablet | default: 4 }}rem !important;
    }
  }

  @media screen and (min-width: 1024px) {
    .weblegko-collections-padding {
      padding-top: {{ section.settings.padding_top_desktop | default: 6 }}rem !important;
      padding-bottom: {{ section.settings.padding_bottom_desktop | default: 6 }}rem !important;
    }
  }

  /* ============================================ */
  /* GRID С БРЕЙКПОИНТАМИ (колонки, gap) */
  /* ============================================ */
  #weblegko-collections-grid {
    display: grid !important;
    grid-template-columns: repeat({{ section.settings.columns_mobile | default: 2 }}, 1fr) !important;
    gap: {{ section.settings.row_gap_mobile | default: 1 }}rem {{ section.settings.col_gap_mobile | default: 0.5 }}rem !important;
  }

  @media screen and (min-width: 640px) and (max-width: 1023px) {
    #weblegko-collections-grid {
      grid-template-columns: repeat({{ section.settings.columns_tablet | default: 3 }}, 1fr) !important;
      gap: {{ section.settings.row_gap_tablet | default: 1.5 }}rem {{ section.settings.col_gap_tablet | default: 1 }}rem !important;
    }
  }

  @media screen and (min-width: 1024px) {
    #weblegko-collections-grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop | default: 6 }}, 1fr) !important;
      gap: {{ section.settings.row_gap_desktop | default: 2 }}rem {{ section.settings.col_gap_desktop | default: 2 }}rem !important;
    }
  }
</style>

<section class="weblegko-collections-padding tw:bg-seriy tw:text-grayscale-950 tw:px-[1.6rem]">  
<div class="tw:max-w-[112rem] tw:mx-auto">
<!-- Заголовок секции -->
    {%- if section.settings.heading != blank -%}
      <div class="tw:flex tw:flex-col tw:items-center tw:gap-[1rem] tw:mb-[3rem]">
        <h2 class="tw:font-poppins tw:text-[2.4rem] tw:sm:text-[4rem] tw:font-medium tw:tracking-[-0.04em] tw:leading-[1.2] tw:text-center">
          {{ section.settings.heading }}
        </h2>

        {% comment %} можно чета дообавить       {% endcomment %}
      </div>
    {%- endif -%}

    <ul id="weblegko-collections-grid" class="tw:list-none tw:p-0 tw:m-0">
      {%- for i in (1..6) -%}
        {%- assign current_block = section.blocks[forloop.index0] -%}
        <li 
          class="tw:flex tw:justify-center {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          {% if settings.animations_reveal_on_scroll %}data-cascade style="--animation-order: {{ forloop.index }};"{% endif %}
        >
          
          {%- if current_block != blank and current_block.settings.collection != blank -%}
            {%- assign collection = current_block.settings.collection -%}
            <!-- ЕСЛИ КОЛЛЕКЦИЯ ЕСТЬ -->
            <a href="{{ collection.url }}" class="tw:flex tw:flex-col tw:items-center tw:text-center  tw:w-full tw:max-w-[20rem] tw:no-underline tw:text-inherit group">
              
              <div class="tw:border tw:shadow-lg tw:border-black/10 tw:w-full tw:aspect-square tw:rounded-full tw:overflow-hidden tw:mb-[1rem] tw:transition-transform tw:duration-300 group-hover:tw:scale-[105%]">
                {%- if collection.image != blank -%}
                  <img 
                    srcset="{%- if collection.image.width >= 165 -%}{{ collection.image | image_url: width: 165 }} 165w,{%- endif -%}
                            {%- if collection.image.width >= 360 -%}{{ collection.image | image_url: width: 360 }} 360w,{%- endif -%}
                            {%- if collection.image.width >= 533 -%}{{ collection.image | image_url: width: 533 }} 533w,{%- endif -%}
                            {{ collection.image | image_url }} {{ collection.image.width }}w"
                    src="{{ collection.image | image_url: width: 533 }}"
                    sizes="(min-width: 1024px) calc((100vw - 8rem) / {{ section.settings.columns_desktop | default: 6 }}), (min-width: 640px) calc((100vw - 4rem) / {{ section.settings.columns_tablet | default: 5 }}), calc((100vw - 3rem) / {{ section.settings.columns_mobile | default: 2 }})"
                    alt="{{ collection.image.alt | escape }}"
                    loading="lazy"
                    class="tw:w-full tw:h-full tw:object-cover tw:block tw:hover:scale-[105%] tw:transition-all tw:duration-300"
                    width="{{ collection.image.width }}"
                    height="{{ collection.image.height }}"
                  >
                {%- elsif collection.products.first and collection.products.first.featured_image != blank -%}
                  {%- assign image = collection.products.first.featured_image -%}
                  <img 
                    src="{{ image | image_url: width: 533 }}"
                    alt="{{ image.alt | escape }}"
                    loading="lazy"
                    class="tw:w-full tw:h-full tw:object-cover tw:block tw:hover:scale-[105%] tw:transition-all tw:duration-300"
                    width="{{ image.width }}"
                    height="{{ image.height }}"
                  >
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'tw:w-full tw:h-full tw:object-cover tw:block  tw:hover:scale-[105%] tw:transition-all tw:duration-300' }}
                {%- endif -%}
              </div>

              <h3 class="tw:text-[1.2rem] tw:font-medium tw:m-0 tw:mb-[0.5rem]">
                {{ collection.title }}
              </h3>
              <span class="tw:flex tw:items-center tw:gap-2 tw:text-[1rem] tw:hover:no-underline tw:underline tw:underline-offset-[0.3rem] tw:opacity-80 group-hover:tw:opacity-100 tw:transition-opacity tw:duration-200">             
                  View Collection 
                 <svg class="tw:w-[1.3em] tw:h-[1.3em]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"/>
                      <polyline points="12 8 16 12 12 16"/>
                      <line x1="8" y1="12" x2="16" y2="12"/>
                </svg>
              </span>
              
            </a>

          {%- else -%}
            <!-- ЕСЛИ КОЛЛЕКЦИИ НЕТ (ПЛЕЙСХОЛДЕР) -->
            <div class="tw:flex tw:flex-col tw:w-full tw:max-w-[20rem] tw:items-center tw:text-center tw:opacity-30 tw:pointer-events-none tw:select-none">
              <div class="tw:shadow-lg tw:border tw:border-dashed tw:border-black/40 tw:w-full tw:aspect-square tw:rounded-full tw:mb-[1rem] tw:flex tw:items-center tw:justify-center">
                <svg class="tw:w-[2.5rem] tw:h-[2.5rem]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="12" y1="5" x2="12" y2="19"></line>
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
              </div>
              <h3 class="tw:text-[1.2rem] tw:font-medium tw:m-0 tw:mb-[0.5rem]">
                Empty
              </h3>
              <span class="tw:flex tw:items-center tw:gap-2 tw:text-[1rem]">             
                Add collection
              </span>
            </div>
          {%- endif -%}

        </li>
      {%- endfor -%}
    </ul>

    <div class="tw:flex tw:justify-center">
      <a href="/collections" class="tw:mt-[2.5rem] tw:md:mt-[4rem] tw:inline-flex tw:items-center tw:justify-center tw:rounded-full tw:transition-colors tw:duration-300 tw:ease-in-out tw:hover:bg-golden tw:px-[1.6rem] tw:pt-1 tw:h-[3.6rem] tw:bg-white tw:text-[1.4rem] tw:leading-[1.43] tw:tracking-[-0.04em] tw:font-medium tw:shadow-md disabled:tw:opacity-70 disabled:tw:cursor-not-allowed">
        View all collections
      </a>
    </div>
    
</div>
</section>

{% schema %}
{
  "name": "DRBERG COLLECTIONS",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Browse popular collection",
      "label": "Heading"
    },
    {
      "type": "header",
      "content": "🖥️ Desktop (≥ 1024px)"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 6,
      "label": "Number of columns"
    },
    {
      "type": "range",
      "id": "col_gap_desktop",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "default": 2,
      "unit": "rem",
      "label": "Column gap"
    },
    {
      "type": "range",
      "id": "row_gap_desktop",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "default": 2,
      "unit": "rem",
      "label": "Row gap (vertical)"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 20,
      "step": 0.5,
      "default": 6,
      "unit": "rem",
      "label": "Padding top"
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 20,
      "step": 0.5,
      "default": 6,
      "unit": "rem",
      "label": "Padding bottom"
    },
    {
      "type": "header",
      "content": "💻 Tablet (640px - 1024px)"
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3,
      "label": "Number of columns"
    },
    {
      "type": "range",
      "id": "col_gap_tablet",
      "min": 0,
      "max": 4,
      "step": 0.5,
      "default": 1,
      "unit": "rem",
      "label": "Column gap"
    },
    {
      "type": "range",
      "id": "row_gap_tablet",
      "min": 0,
      "max": 4,
      "step": 0.5,
      "default": 2.5,
      "unit": "rem",
      "label": "Row gap (vertical)"
    },
    {
      "type": "range",
      "id": "padding_top_tablet",
      "min": 0,
      "max": 15,
      "step": 0.5,
      "default": 5,
      "unit": "rem",
      "label": "Padding top"
    },
    {
      "type": "range",
      "id": "padding_bottom_tablet",
      "min": 0,
      "max": 15,
      "step": 0.5,
      "default": 5,
      "unit": "rem",
      "label": "Padding bottom"
    },
    {
      "type": "header",
      "content": "📱 Mobile (< 640px)"
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2,
      "label": "Number of columns"
    },
    {
      "type": "range",
      "id": "col_gap_mobile",
      "min": 0,
      "max": 3,
      "step": 0.5,
      "default": 0.5,
      "unit": "rem",
      "label": "Column gap"
    },
    {
      "type": "range",
      "id": "row_gap_mobile",
      "min": 0,
      "max": 3,
      "step": 0.5,
      "default": 2.5,
      "unit": "rem",
      "label": "Row gap (vertical)"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 10,
      "step": 0.5,
      "default": 3,
      "unit": "rem",
      "label": "Padding top"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 10,
      "step": 0.5,
      "default": 3,
      "unit": "rem",
      "label": "Padding bottom"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "limit": 6,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "DRBERG COLLECTIONS",
      "category": "Home page",
      "blocks": [       
      ]
    }
  ]
}
{% endschema %}