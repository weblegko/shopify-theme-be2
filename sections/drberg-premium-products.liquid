{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{% if section.settings.image_shape == 'blob' %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
{%- endunless -%}

{{ 'drberg-premium-products.css' | asset_url | stylesheet_tag }}

{%- if section.settings.quick_add == 'standard' -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if section.settings.quick_add == 'bulk' -%}
  <script src="{{ 'quick-add-bulk.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-order-list.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<script src="{{ 'drberg-premium-products.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .drberg-premium-padding {
    padding-top: {{ section.settings.padding_top_mobile | default: 3 }}rem !important;
    padding-bottom: {{ section.settings.padding_bottom_mobile | default: 3 }}rem !important;
  }
  @media screen and (min-width: 640px) {
    .drberg-premium-padding {
      padding-top: {{ section.settings.padding_top_tablet | default: 5 }}rem !important;
      padding-bottom: {{ section.settings.padding_bottom_tablet | default: 5 }}rem !important;
    }
  }
  @media screen and (min-width: 1024px) {
    .drberg-premium-padding {
      padding-top: {{ section.settings.padding_top_desktop | default: 8 }}rem !important;
      padding-bottom: {{ section.settings.padding_bottom_desktop | default: 8 }}rem !important;
    }
  }
{%- endstyle -%}

<section class="drberg-premium">
  <div class="drberg-premium-padding drberg-premium__container">   
    {%- if section.settings.heading != blank -%}
      <div class="drberg-premium__header">
        <h2 class="drberg-premium__heading">
          {{ section.settings.heading }}
        </h2>
        {%- if section.settings.description != blank -%}
          <div class="drberg-premium__badge">
            <span class="drberg-premium__badge-text">
              {{ section.settings.description }}
            </span>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="drberg-premium__overflow-wrapper">
       {% comment %} Слайдер (передаем динамические отступы через data-атрибуты для JS)  {% endcomment %}
      <div 
        class="swiper premiumSwiper drberg-premium__swiper"
        data-space-mobile="{{ section.settings.space_between_mobile | default: 1 | times: 10 }}"
        data-space-tablet="{{ section.settings.space_between_tablet | default: 2 | times: 10 }}"
        data-space-desktop="{{ section.settings.space_between_desktop | default: 2 | times: 10 }}"
      >
        <div class="swiper-wrapper">
          {%- if section.settings.collection != blank -%}
            {%- assign skip_card_product_styles = false -%}
            {%- for product in section.settings.collection.products -%}
              {%- assign lazy_load = false -%}
              {%- if forloop.index > 2 -%}
                {%- assign lazy_load = true -%}
              {%- endif -%}
              <div class="swiper-slide drberg-premium__slide">
                <div class="drberg-premium__slide-inner">
                  {% render 'card-product-premium',
                    card_product: product,
                    media_aspect_ratio: section.settings.image_ratio,
                    image_shape: section.settings.image_shape,
                    show_secondary_image: section.settings.show_secondary_image,
                    show_vendor: section.settings.show_vendor,
                    show_rating: section.settings.show_rating,
                    lazy_load: lazy_load,
                    skip_styles: skip_card_product_styles,
                    quick_add: section.settings.quick_add,
                    section_id: section.id
                  %}
                </div>
              </div>
              {%- assign skip_card_product_styles = true -%}
            {%- endfor -%}

          {%- else -%}            
            {%- for i in (1..3) -%}
              <div class="swiper-slide drberg-premium__slide">
                <div class="drberg-premium__placeholder">
                  <div class="drberg-premium__placeholder-img-wrapper">
                    {{ 'product-1' | placeholder_svg_tag: 'drberg-premium__placeholder-icon' }}
                  </div>
                  <div class="drberg-premium__placeholder-text-wrapper">
                    <div class="drberg-premium__placeholder-bar--1"></div>
                    <div class="drberg-premium__placeholder-bar--2"></div>
                    <div class="drberg-premium__placeholder-bar--3"></div>
                    <div class="drberg-premium__placeholder-bar--4"></div>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    </div>

    {% comment %} Пагинация  {% endcomment %}
    <div class="premium-pagination drberg-premium__pagination"></div>
  </div>
</section>

{% schema %}
{
  "name": "DRBERG PREMIUM",
  "tag": "section",
  "class": "section-premium-products",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Premium Products",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "description",
      "default": "Premium supplements for your health",
      "label": "Description Badge"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "header",
      "content": "🖥️ Desktop (≥ 1024px)"
    },
    {
      "type": "range",
      "id": "space_between_desktop",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "default": 2,
      "unit": "rem",
      "label": "Space between slides"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 20,
      "step": 0.5,
      "default": 8,
      "unit": "rem",
      "label": "Padding top"
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 20,
      "step": 0.5,
      "default": 8,
      "unit": "rem",
      "label": "Padding bottom"
    },
    {
      "type": "header",
      "content": "💻 Tablet (640px - 1024px)"
    },
    {
      "type": "range",
      "id": "space_between_tablet",
      "min": 0,
      "max": 4,
      "step": 0.5,
      "default": 2,
      "unit": "rem",
      "label": "Space between slides"
    },
    {
      "type": "range",
      "id": "padding_top_tablet",
      "min": 0,
      "max": 15,
      "step": 0.5,
      "default": 5,
      "unit": "rem",
      "label": "Padding top"
    },
    {
      "type": "range",
      "id": "padding_bottom_tablet",
      "min": 0,
      "max": 15,
      "step": 0.5,
      "default": 5,
      "unit": "rem",
      "label": "Padding bottom"
    },
    {
      "type": "header",
      "content": "📱 Mobile (< 640px)"
    },
    {
      "type": "range",
      "id": "space_between_mobile",
      "min": 0,
      "max": 3,
      "step": 0.5,
      "default": 1,
      "unit": "rem",
      "label": "Space between slides"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 10,
      "step": 0.5,
      "default": 3,
      "unit": "rem",
      "label": "Padding top"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 10,
      "step": 0.5,
      "default": 3,
      "unit": "rem",
      "label": "Padding bottom"
    },
    {
      "type": "header",
      "content": "Product Card"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" }
      ],
      "default": "adapt",
      "label": "Image ratio"
    },
    {
      "type": "select",
      "id": "image_shape",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "arch", "label": "Arch" },
        { "value": "blob", "label": "Blob" },
        { "value": "chevronleft", "label": "Chevron left" },
        { "value": "chevronright", "label": "Chevron right" },
        { "value": "diamond", "label": "Diamond" },
        { "value": "parallelogram", "label": "Parallelogram" },
        { "value": "round", "label": "Round" }
      ],
      "default": "default",
      "label": "Image shape"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": false,
      "label": "Show second image on hover"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "Show vendor"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": false,
      "label": "Show product rating",
      "info": "To display a rating, add a product rating app."
    },
    {
      "type": "select",
      "id": "quick_add",
      "default": "standard",
      "label": "Quick add",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "standard", "label": "Standard" },
        { "value": "bulk", "label": "Bulk" }
      ]
    }
  ],
  "presets": [
    {
      "name": "DRBERG PREMIUM",
      "category": "Page"
    }
  ]
}
{% endschema %}