{{ 'weblegko-typo.css' | asset_url | stylesheet_tag }}
<style>
  .drberg-faq-padding {
    padding-top: {{ section.settings.padding_top_mobile | default: 3 }}rem !important;
    padding-bottom: {{ section.settings.padding_bottom_mobile | default: 3 }}rem !important;
  }
  @media screen and (min-width: 640px) {
    .drberg-faq-padding {
      padding-top: {{ section.settings.padding_top_tablet | default: 5 }}rem !important;
      padding-bottom: {{ section.settings.padding_bottom_tablet | default: 5 }}rem !important;
    }
  }
  @media screen and (min-width: 1024px) {
    .drberg-faq-padding {
      padding-top: {{ section.settings.padding_top_desktop | default: 8 }}rem !important;
      padding-bottom: {{ section.settings.padding_bottom_desktop | default: 8 }}rem !important;
    }
  }

   {% comment %} ОТСТУПЫ МЕЖДУ КАТЕГОРИЯМИ  {% endcomment %}
  .drberg-faq-cat-gap {
    gap: {{ section.settings.gap_categories_mobile | default: 3 }}rem !important;
  }
  @media screen and (min-width: 640px) {
    .drberg-faq-cat-gap {
      gap: {{ section.settings.gap_categories_tablet | default: 4 }}rem !important;
    }
  }
  @media screen and (min-width: 1024px) {
    .drberg-faq-cat-gap {
      gap: {{ section.settings.gap_categories_desktop | default: 5 }}rem !important;
    }
  }


   {% comment %} ОТСТУПЫ МЕЖДУ ВОПРОСАМИ (ITEMS)  {% endcomment %}
  .drberg-faq-item-gap {
    gap: {{ section.settings.gap_items_mobile | default: 1.5 }}rem !important;
  }
  @media screen and (min-width: 640px) {
    .drberg-faq-item-gap {
      gap: {{ section.settings.gap_items_tablet | default: 2 }}rem !important;
    }
  }
  @media screen and (min-width: 1024px) {
    .drberg-faq-item-gap {
      gap: {{ section.settings.gap_items_desktop | default: 2.5 }}rem !important;
    }
  }

  {% comment %} Стили аккордеона  {% endcomment %}
  summary::-webkit-details-marker { display: none; }
  summary { list-style: none; }
  details[open] summary .faq-icon-plus { opacity: 0; }
  details[open] summary .faq-icon-minus { opacity: 1; }
  
  .faq__question h3 { margin: 0; }
</style>

 {% comment %} Подключаем внешний скрипт аккордеона  {% endcomment %}
<script src="{{ 'drberg-faq.js' | asset_url }}" defer="defer"></script>

<section class="drberg-faq">
  <div class="drberg-faq-padding drberg-faq__container">
    
    {%- comment -%} === ЗАГОЛОВОК СЕКЦИИ === {%- endcomment -%}
    {%- if section.settings.heading != blank -%}
      <div class="drberg-faq__header">
        <h2 class="drberg-faq__heading">
          {{ section.settings.heading }}
        </h2>
        {%- if section.settings.rating_score != blank and section.settings.review_count != blank -%}
          <div class="drberg-faq__rating-badge">
            <span class="drberg-faq__rating-text">
              Rated {{ section.settings.rating_score }}/5 based on {{ section.settings.review_count }} reviews
            </span>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} === ПОЛУЧЕНИЕ ДАННЫХ ИЗ МЕТАОБЪЕКТОВ === {%- endcomment -%}
    {%- assign categories = shop.metaobjects.faq_category.values | sort: 'position' -%}
    {%- assign all_items = shop.metaobjects.faq_item.values | sort: 'position' -%}
    {%- assign faq_limit = section.settings.questions_limit | plus: 0 -%}
    {%- assign items_shown = 0 -%}

    {%- comment -%} КОНТЕЙНЕР ДЛЯ КАТЕГОРИЙ {%- endcomment -%}
    <div class="drberg-faq-cat-gap drberg-faq__categories">
      
      {%- for category in categories -%}
        <div class="faq__category-block">
          
          {%- comment -%} ВЫВОД НАЗВАНИЯ КАТЕГОРИИ (если не скрыто) {%- endcomment -%}
          {%- unless section.settings.hide_categories -%}
            {%- if category.name != blank -%}
              <h2 class="drberg-faq__category-title">
                {{ category.name }}
              </h2>
            {%- endif -%}
          {%- endunless -%}

          {%- comment -%} КОНТЕЙНЕР ДЛЯ ВОПРОСОВ ВНУТРИ КАТЕГОРИИ {%- endcomment -%}
          <div class="drberg-faq-item-gap drberg-faq__items">
            
            {%- for item in all_items -%}
              {%- if item.category.value.system.handle == category.system.handle and item.published.value -%}
                
                {%- comment -%} ФИЛЬТР ДЛЯ ГЛАВНОЙ СТРАНИЦЫ (пропускаем вопросы без галочки show_on_homepage) {%- endcomment -%}
                {%- if section.settings.homepage_mode and item.show_on_homepage.value != true -%}
                  {%- continue -%}
                {%- endif -%}

                {%- comment -%} ПРОВЕРКА ЛИМИТА {%- endcomment -%}
                {%- if faq_limit > 0 and items_shown >= faq_limit -%}
                  {%- break -%}
                {%- endif -%}

                {%- assign rendered_answer = item.answer | metafield_tag -%}

                <details class="faq-animate drberg-faq__item">
                  <summary class="drberg-faq__summary">
                    
                    <h3 class="faq__question drberg-faq__question">
                      {{ item.question }}
                    </h3>

                    <span class="drberg-faq__icon-wrapper">
                      <svg class="faq-icon-plus drberg-faq__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v12m6-6H6"></path>
                      </svg>
                      <svg class="faq-icon-minus drberg-faq__icon drberg-faq__icon--minus" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 12H6"></path>
                      </svg>
                    </span>
                  </summary>

                  {%- comment -%} ВЫВОДИМ ОТРЕЕНДЕРЕННЫЙ ОТВЕТ {%- endcomment -%}
                  <div class="faq-content typo drberg-faq__answer">
                    {{ rendered_answer }}
                  </div>
                </details>

                {%- assign items_shown = items_shown | plus: 1 -%}

              {%- endif -%}
            {%- endfor -%}
            
          </div>
        </div>
        
        {%- comment -%} Если достигли лимита, прерываем цикл категорий {%- endcomment -%}
        {%- if faq_limit > 0 and items_shown >= faq_limit -%}
          {%- break -%}
        {%- endif -%}

      {%- endfor -%}
      
    </div>

    {%- comment -%} === КНОПКА MORE FAQ === {%- endcomment -%}
    {%- if section.settings.faq_page != blank -%}
      <div class="drberg-faq__btn-wrapper">
        <a href="{{ section.settings.faq_page.url }}" class="drberg-faq__btn">
          {{ section.settings.button_text | default: 'More FAQ' }}
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

{%- comment -%} === FAQPage JSON-LD (ДЛЯ ИИ) === {%- endcomment -%}
{%- unless section.settings.disable_jsonld -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- assign first = true -%}
    {%- for item in all_items -%}
      {%- if item.published.value -%}
        {%- unless first %},{% endunless -%}
        {%- assign first = false -%}
        {%- assign answer_html = item.answer | metafield_tag -%}
        {%- assign answer_text = answer_html | strip_html | strip_newlines | strip -%}
        {
          "@type": "Question",
          "name": {{ item.question | json }},
          "acceptedAnswer": {
            "@type": "Answer",
            "text": {{ answer_text | json }}
          }
        }
      {%- endif -%}
    {%- endfor -%}
  ]
}
</script>
{%- endunless -%}

{% schema %}
{
  "name": "DRBERG FAQ META",
  "tag": "section",
  "class": "section-faq",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Frequently Asked Questions",
      "label": "Heading"
    },
    {
      "type": "checkbox",
      "id": "disable_jsonld",
      "label": "Отключить JSON-LD (для главной страницы)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_categories",
      "label": "Спрятать названия категорий",
      "default": false,
      "info": "Включите для главной страницы, чтобы выводить просто список вопросов"
    },  
    {
      "type": "header",
      "content": "Questions Output"
    },
    {
      "type": "checkbox",
      "id": "homepage_mode",
      "label": "Режим главной страницы (только избранные)",
      "default": false,
      "info": "Выводить только вопросы, у которых в базе стоит галочка 'Show on Homepage'"
    },
    {
      "type": "range",
      "id": "questions_limit",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 0,
      "unit": "qs",
      "label": "Limit questions",
      "info": "0 = Show all questions. Use 5-7 for Homepage."
    },
    {
      "type": "header",
      "content": "More FAQ Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "default": "More FAQ",
      "label": "Button Text"
    },
    {
      "type": "page",
      "id": "faq_page",
      "label": "Select FAQ Page"
    },
    {
      "type": "header",
      "content": "🖥️ Desktop (≥ 1024px)"
    },
        {
      "type": "header",
      "content": "Reviews Statistics"
    },
    {
      "type": "text",
      "id": "rating_score",
      "default": "4.8",
      "label": "Average rating score"
    },
    {
      "type": "text",
      "id": "review_count",
      "default": "2,847",
      "label": "Total number of reviews"
    },
    {
      "type": "range", "id": "gap_categories_desktop", "min": 0, "max": 10, "step": 0.5, "default": 2.5, "unit": "rem", "label": "Gap between categories"
    },
    {
      "type": "range", "id": "gap_items_desktop", "min": 0, "max": 5, "step": 0.5, "default": 2.5, "unit": "rem", "label": "Gap between items"
    },
    {
      "type": "range", "id": "padding_top_desktop", "min": 0, "max": 20, "step": 0.5, "default": 8, "unit": "rem", "label": "Padding top"
    },
    {
      "type": "range", "id": "padding_bottom_desktop", "min": 0, "max": 20, "step": 0.5, "default": 8, "unit": "rem", "label": "Padding bottom"
    },
    {
      "type": "header",
      "content": "💻 Tablet (640px - 1024px)"
    },
    {
      "type": "range", "id": "gap_categories_tablet", "min": 0, "max": 8, "step": 0.5, "default": 2, "unit": "rem", "label": "Gap between categories"
    },
    {
      "type": "range", "id": "gap_items_tablet", "min": 0, "max": 4, "step": 0.5, "default": 2, "unit": "rem", "label": "Gap between items"
    },
    {
      "type": "range", "id": "padding_top_tablet", "min": 0, "max": 15, "step": 0.5, "default": 5, "unit": "rem", "label": "Padding top"
    },
    {
      "type": "range", "id": "padding_bottom_tablet", "min": 0, "max": 15, "step": 0.5, "default": 5, "unit": "rem", "label": "Padding bottom"
    },
    {
      "type": "header",
      "content": "📱 Mobile (< 640px)"
    },
    {
      "type": "range", "id": "gap_categories_mobile", "min": 0, "max": 5, "step": 0.5, "default": 1.5, "unit": "rem", "label": "Gap between categories"
    },
    {
      "type": "range", "id": "gap_items_mobile", "min": 0, "max": 3, "step": 0.5, "default": 1.5, "unit": "rem", "label": "Gap between items"
    },
    {
      "type": "range", "id": "padding_top_mobile", "min": 0, "max": 10, "step": 0.5, "default": 3, "unit": "rem", "label": "Padding top"
    },
    {
      "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 10, "step": 0.5, "default": 3, "unit": "rem", "label": "Padding bottom"
    }
  ],
  "presets": [
    {
      "name": "DRBERG FAQ META",
      "category": "Page"
    }
  ]
}
{% endschema %}