      "max": 12,
      "step": 1,
      "default": 3,
      "label": "Number of reviews to show on homepage"
    },
    {
      "type": "text",
      "id": "button_text",
      "default": "Show More Reviews",
      "label": "Button Text"
    },
    {
      "type": "url",
