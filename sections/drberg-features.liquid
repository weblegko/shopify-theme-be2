      "type": "range",
      "id": "row_gap_tablet",
      "min": 0,
      "max": 4,
      "step": 0.5,
      "default": 1.5,
      "unit": "rem",
      "label": "Row gap (vertical)"
    },
    {
      "type": "range",
      "id": "padding_top_tablet",
      "min": 0,
      "max": 15,
      "step": 0.5,
      "default": 5,
      "unit": "rem",
      "label": "Padding top"
    },
    {
      "type": "range",
      "id": "padding_bottom_tablet",
      "min": 0,
      "max": 15,
      "step": 0.5,
      "default": 5,
      "unit": "rem",
      "label": "Padding bottom"
    },
    {
      "type": "header",
      "content": "📱 Mobile (< 640px)"
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1,
      "label": "Number of columns"
    },
    {
      "type": "range",
      "id": "col_gap_mobile",
      "min": 0,
      "max": 3,
      "step": 0.5,
      "default": 0.5,
      "unit": "rem",
      "label": "Column gap"
    },
    {
      "type": "range",
      "id": "row_gap_mobile",
      "min": 0,
      "max": 3,
      "step": 0.5,
      "default": 1,
      "unit": "rem",
      "label": "Row gap (vertical)"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
