      "label": "Padding bottom"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Feature",
      "settings": [
        {
          "type": "textarea",
          "id": "icon_svg",
          "label": "SVG Icon Code",
          "info": "Paste your SVG code here. Use 'currentColor' for the stroke or fill."
        },
        {
          "type": "text",
          "id": "title",
          "default": "Fast Delivery",
          "label": "Feature Title"
