{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{% if section.settings.image_shape == 'blob' %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
{%- endunless -%}

{%- if section.settings.quick_add == 'standard' -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if section.settings.quick_add == 'bulk' -%}
  <script src="{{ 'quick-add-bulk.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-order-list.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{{ 'drberg-popular-products.css' | asset_url | stylesheet_tag }}

<style>
  .drberg-popular-padding {
    padding-top: {{ section.settings.padding_top_mobile | default: 3 }}rem !important;
    padding-bottom: {{ section.settings.padding_bottom_mobile | default: 3 }}rem !important;
  }
  @media screen and (min-width: 640px) {
    .drberg-popular-padding {
      padding-top: {{ section.settings.padding_top_tablet | default: 5 }}rem !important;
      padding-bottom: {{ section.settings.padding_bottom_tablet | default: 5 }}rem !important;
    }
  }
  @media screen and (min-width: 1024px) {
    .drberg-popular-padding {
      padding-top: {{ section.settings.padding_top_desktop | default: 8 }}rem !important;
      padding-bottom: {{ section.settings.padding_bottom_desktop | default: 8 }}rem !important;
    }
  }
  #drberg-popular-grid {
    grid-template-columns: repeat({{ section.settings.columns_mobile | default: 1 }}, 1fr) !important;
    gap: {{ section.settings.row_gap_mobile | default: 1 }}rem {{ section.settings.col_gap_mobile | default: 1 }}rem !important;
  }
  @media screen and (min-width: 640px) and (max-width: 1023px) {
    #drberg-popular-grid {
      grid-template-columns: repeat({{ section.settings.columns_tablet | default: 2 }}, 1fr) !important;
      gap: {{ section.settings.row_gap_tablet | default: 1.5 }}rem {{ section.settings.col_gap_tablet | default: 1.5 }}rem !important;
    }
  }
  @media screen and (min-width: 1024px) {
    #drberg-popular-grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop | default: 3 }}, 1fr) !important;
      gap: {{ section.settings.row_gap_desktop | default: 2 }}rem {{ section.settings.col_gap_desktop | default: 2 }}rem !important;
    }
  }
</style>

{%- comment -%}
  Определяем сколько товаров показывать на каждом брейкпоинте
{%- endcomment -%}
{%- assign desktop_limit = section.settings.products_to_show_desktop | default: 6 -%}
{%- assign tablet_limit = section.settings.products_to_show_tablet | default: 6 -%}
{%- assign mobile_limit = section.settings.products_to_show_mobile | default: 6 -%}

<section class="section-popular-products drberg-popular">
  <div class="drberg-popular-padding drberg-popular__container">
    {%- if section.settings.heading != blank -%}
      <div class="drberg-popular__header">
        <h2 class="drberg-popular__heading">
          {{ section.settings.heading }}
        </h2>
        {%- if section.settings.description != blank -%}
          <div class="drberg-popular__badge">
            <span class="drberg-popular__badge-text">
              {{ section.settings.description }}
            </span>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {% comment %} Сетка товаров  {% endcomment %}
    <div
      id="drberg-popular-grid"
      data-id="{{ section.id }}"
      class="product-grid"
    >
      {%- if section.settings.collection != blank -%}
        {%- assign product_count = 0 -%}
        {%- assign skip_card_product_styles = false -%}
        {%- for product in section.settings.collection.products -%}
          {%- assign product_count = forloop.index -%}
          {%- assign lazy_load = false -%}
          {%- if forloop.index > 2 -%}
            {%- assign lazy_load = true -%}
          {%- endif -%}
          <div
            class="grid__item {% if product_count > mobile_limit %}drberg-popular-hide-mobile{% endif %}{% if product_count > tablet_limit %}drberg-popular-hide-tablet {% endif %}{% if product_count > desktop_limit %}drberg-popular-hide-desktop {% endif %}{% if settings.animations_reveal_on_scroll %}scroll-trigger animate--slide-in {% endif %}"
            {% if settings.animations_reveal_on_scroll %}
              data-cascade style="--animation-order: {{ forloop.index }};"
            {% endif %}
          >
            {% render 'card-product',
              card_product: product,
              media_aspect_ratio: section.settings.image_ratio,
              image_shape: section.settings.image_shape,
              show_secondary_image: section.settings.show_secondary_image,
              show_vendor: section.settings.show_vendor,
              show_rating: section.settings.show_rating,
              lazy_load: lazy_load,
              skip_styles: skip_card_product_styles,
              quick_add: section.settings.quick_add,
              section_id: section.id
            %}
          </div>
          {%- assign skip_card_product_styles = true -%}
        {%- endfor -%}

      {%- else -%}
        {% comment %} Плейсхолдеры  {% endcomment %}
        {%- for i in (1..6) -%}
          <div class="drberg-popular__placeholder">
            <div class="drberg-popular__placeholder-img-wrapper">
              {{ 'product-1' | placeholder_svg_tag: 'drberg-popular__placeholder-icon' }}
            </div>
            <div class="drberg-popular__placeholder-text-wrapper">
              <div class="drberg-popular__placeholder-bar drberg-popular__placeholder-bar--1"></div>
              <div class="drberg-popular__placeholder-bar drberg-popular__placeholder-bar--2"></div>
              <div class="drberg-popular__placeholder-bar drberg-popular__placeholder-bar--3"></div>
              <div class="drberg-popular__placeholder-bar drberg-popular__placeholder-bar--4"></div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "DRBERG POPULAR",
  "tag": "section",
  "class": "section-popular-products",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Popular Products",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "description",
      "default": "Premium supplements for your health",
      "label": "Description Badge"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "header",
      "content": "🖥️ Desktop (≥ 1024px)"
    },
    {
      "type": "range",
      "id": "products_to_show_desktop",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 6,
      "label": "Number of products to show"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3,
      "label": "Number of columns"
    },
    {
      "type": "range",
      "id": "col_gap_desktop",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "default": 2,
      "unit": "rem",
      "label": "Column gap"
    },
    {
      "type": "range",
      "id": "row_gap_desktop",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "default": 2,
      "unit": "rem",
      "label": "Row gap (vertical)"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 20,
      "step": 0.5,
      "default": 8,
      "unit": "rem",
      "label": "Padding top"
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 20,
      "step": 0.5,
      "default": 8,
      "unit": "rem",
      "label": "Padding bottom"
    },
    {
      "type": "header",
      "content": "💻 Tablet (640px - 1024px)"
    },
    {
      "type": "range",
      "id": "products_to_show_tablet",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 4,
      "label": "Number of products to show"
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2,
      "label": "Number of columns"
    },
    {
      "type": "range",
      "id": "col_gap_tablet",
      "min": 0,
      "max": 4,
      "step": 0.5,
      "default": 1.5,
      "unit": "rem",
      "label": "Column gap"
    },
    {
      "type": "range",
      "id": "row_gap_tablet",
      "min": 0,
      "max": 4,
      "step": 0.5,
      "default": 1.5,
      "unit": "rem",
      "label": "Row gap (vertical)"
    },
    {
      "type": "range",
      "id": "padding_top_tablet",
      "min": 0,
      "max": 15,
      "step": 0.5,
      "default": 5,
      "unit": "rem",
      "label": "Padding top"
    },
    {
      "type": "range",
      "id": "padding_bottom_tablet",
      "min": 0,
      "max": 15,
      "step": 0.5,
      "default": 5,
      "unit": "rem",
      "label": "Padding bottom"
    },
    {
      "type": "header",
      "content": "📱 Mobile (< 640px)"
    },
    {
      "type": "range",
      "id": "products_to_show_mobile",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 2,
      "label": "Number of products to show"
