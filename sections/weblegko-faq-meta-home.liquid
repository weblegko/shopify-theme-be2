
<!-- sections/faq.liquid -->

<style>
  /* ============================================ */
  /* ПАДДИНГИ СЕКЦИИ */
  /* ============================================ */
  .drberg-faq-padding {
    padding-top: {{ section.settings.padding_top_mobile | default: 3 }}rem !important;
    padding-bottom: {{ section.settings.padding_bottom_mobile | default: 3 }}rem !important;
  }
  @media screen and (min-width: 640px) {
    .drberg-faq-padding {
      padding-top: {{ section.settings.padding_top_tablet | default: 5 }}rem !important;
      padding-bottom: {{ section.settings.padding_bottom_tablet | default: 5 }}rem !important;
    }
  }
  @media screen and (min-width: 1024px) {
    .drberg-faq-padding {
      padding-top: {{ section.settings.padding_top_desktop | default: 8 }}rem !important;
      padding-bottom: {{ section.settings.padding_bottom_desktop | default: 8 }}rem !important;
    }
  }

  /* ============================================ */
  /* ОТСТУПЫ МЕЖДУ КАТЕГОРИЯМИ */
  /* ============================================ */
  .drberg-faq-cat-gap {
    gap: {{ section.settings.gap_categories_mobile | default: 3 }}rem !important;
  }
  @media screen and (min-width: 640px) {
    .drberg-faq-cat-gap {
      gap: {{ section.settings.gap_categories_tablet | default: 4 }}rem !important;
    }
  }
  @media screen and (min-width: 1024px) {
    .drberg-faq-cat-gap {
      gap: {{ section.settings.gap_categories_desktop | default: 5 }}rem !important;
    }
  }

  /* ============================================ */
  /* ОТСТУПЫ МЕЖДУ ВОПРОСАМИ (ITEMS) */
  /* ============================================ */
  .drberg-faq-item-gap {
    gap: {{ section.settings.gap_items_mobile | default: 1.5 }}rem !important;
  }
  @media screen and (min-width: 640px) {
    .drberg-faq-item-gap {
      gap: {{ section.settings.gap_items_tablet | default: 2 }}rem !important;
    }
  }
  @media screen and (min-width: 1024px) {
    .drberg-faq-item-gap {
      gap: {{ section.settings.gap_items_desktop | default: 2.5 }}rem !important;
    }
  }

  /* Стили аккордеона */
  summary::-webkit-details-marker { display: none; }
  summary { list-style: none; }
  details[open] summary .faq-icon-plus { opacity: 0; }
  details[open] summary .faq-icon-minus { opacity: 1; }
  
  .faq__question h3 { margin: 0; }
</style>

<section class="tw:bg-seriy tw:text-grayscale-950 tw:px-[1.6rem]">
  <div class="drberg-faq-padding tw:max-w-[112rem] tw:mx-auto">
    
    {%- comment -%} === ЗАГОЛОВОК СЕКЦИИ === {%- endcomment -%}
    {%- if section.settings.heading != blank -%}
      <div class="tw:flex tw:flex-col tw:items-center tw:gap-[1rem] tw:mb-[3rem]">
        <h2 class="tw:font-poppins tw:text-[2.4rem] tw:sm:text-[4rem] tw:font-medium tw:tracking-[-0.04em] tw:leading-[1.2] tw:text-center">
          {{ section.settings.heading }}
        </h2>
        
      </div>
    {%- endif -%}

    {%- comment -%} === ПОЛУЧЕНИЕ ДАННЫХ ИЗ МЕТАОБЪЕКТОВ === {%- endcomment -%}
    {%- assign categories = shop.metaobjects.faq_category.values | sort: 'position' -%}
    {%- assign all_items = shop.metaobjects.faq_item.values | sort: 'position' -%}
    {%- assign faq_limit = section.settings.questions_limit | plus: 0 -%}
    {%- assign items_shown = 0 -%}

    {%- comment -%} КОНТЕЙНЕР ДЛЯ КАТЕГОРИЙ {%- endcomment -%}
    <div class="drberg-faq-cat-gap tw:flex tw:flex-col">
      
      {%- for category in categories -%}
        <div class="faq__category-block">

          {%- comment -%} КОНТЕЙНЕР ДЛЯ ВОПРОСОВ ВНУТРИ КАТЕГОРИИ {%- endcomment -%}
          <div class="drberg-faq-item-gap tw:flex tw:flex-col">
            
            {%- for item in all_items -%}
              {%- if item.category.value.system.handle == category.system.handle and item.published.value -%}
                
                {%- comment -%} ФИЛЬТР ДЛЯ ГЛАВНОЙ СТРАНИЦЫ (пропускаем вопросы без галочки show_on_homepage) {%- endcomment -%}
                {%- if section.settings.homepage_mode and item.show_on_homepage.value != true -%}
                  {%- continue -%}
                {%- endif -%}

                {%- comment -%} ПРОВЕРКА ЛИМИТА {%- endcomment -%}
                {%- if faq_limit > 0 and items_shown >= faq_limit -%}
                  {%- break -%}
                {%- endif -%}

                {%- assign rendered_answer = item.answer | metafield_tag -%}

                <details class="faq-animate tw:hover:scale-[101%] tw:hover:shadow-lg tw:transition-all tw:duration-300 tw:group tw:bg-white tw:rounded-[1.2rem] tw:border tw:border-gray-200 tw:shadow-sm tw:overflow-hidden">
                  <summary class="tw:flex tw:justify-between tw:items-start tw:p-[1.5rem] tw:md:p-[2rem] tw:cursor-pointer tw:transition-colors">
                    
                    <h3 class="faq__question tw:pt-1 tw:text-[1.4rem] tw:font-medium tw:pr-8 tw:leading-[1.4] tw:tracking-[-0.04em] tw:lg:text-[2rem]">
                      {{ item.question }}
                    </h3>

                    <span class="tw:relative tw:w-[2rem] tw:h-[2rem] tw:flex-shrink-0 tw:flex tw:items-center tw:justify-center tw:lg:w-[2.8rem] tw:lg:h-[2.8rem]">
                      <svg class="faq-icon-plus tw:absolute tw:w-full tw:h-full tw:text-golden tw:transition-opacity tw:duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v12m6-6H6"></path>
                      </svg>
                      <svg class="faq-icon-minus tw:absolute tw:w-full tw:h-full tw:text-golden tw:opacity-0 tw:transition-opacity tw:duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 12H6"></path>
                      </svg>
                    </span>
                  </summary>

                  {%- comment -%} ВЫВОДИМ ОТРЕЕНДЕРЕННЫЙ ОТВЕТ {%- endcomment -%}
                  <div class="faq-content typo tw:translate-y-[-1rem] tw:px-[2rem] tw:pb-[1rem] tw:text-[1.3rem] tw:text-[#8b867a] tw:leading-[1.23] tw:tracking-[-0.04em] tw:lg:text-[1.6rem] tw:lg:leading-[1.5]">
                    {{ rendered_answer }}
                  </div>
                </details>

                {%- assign items_shown = items_shown | plus: 1 -%}

              {%- endif -%}
            {%- endfor -%}
            
          </div>
        </div>
        
        {%- comment -%} Если достигли лимита, прерываем цикл категорий {%- endcomment -%}
        {%- if faq_limit > 0 and items_shown >= faq_limit -%}
          {%- break -%}
        {%- endif -%}

      {%- endfor -%}
      
    </div>

    {%- comment -%} === КНОПКА MORE FAQ === {%- endcomment -%}
    {%- if section.settings.faq_page != blank -%}
      <div class="tw:flex tw:justify-center">
        <a href="{{ section.settings.faq_page.url }}" class="tw:mt-[2.5rem] tw:md:mt-[4rem] tw:inline-flex tw:items-center tw:justify-center tw:rounded-full tw:transition-colors tw:duration-300 tw:ease-in-out tw:hover:bg-golden tw:px-[1.6rem] tw:pt-1 tw:h-[3.6rem] tw:bg-white tw:text-[1.4rem] tw:leading-[1.43] tw:tracking-[-0.04em] tw:font-medium tw:shadow-md">
          {{ section.settings.button_text | default: 'More FAQ' }}
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

{%- comment -%} === JS АНИМАЦИЯ === {%- endcomment -%}
<script>
  function shrinkFaq(el, summary) {
    el.animating = true;
    const startHeight = el.offsetHeight + 'px';
    const endHeight = summary.offsetHeight + 'px';
    el.style.overflow = 'hidden';
    const animation = el.animate([{ height: startHeight }, { height: endHeight }], {
      duration: 300, easing: 'ease-out',
    });
    animation.onfinish = () => { el.open = false; el.style.overflow = ''; el.animating = false; };
    animation.oncancel = () => { el.style.overflow = ''; el.animating = false; };
  }

  function openFaq(el, summary, content) {
    el.animating = true;
    el.style.height = el.offsetHeight + 'px';
    el.open = true;
    const startHeight = el.offsetHeight + 'px';
    const endHeight = summary.offsetHeight + content.offsetHeight + 'px';
    el.style.overflow = 'hidden';
    const animation = el.animate([{ height: startHeight }, { height: endHeight }], {
      duration: 300, easing: 'ease-out',
    });
    animation.onfinish = () => { el.style.overflow = ''; el.style.height = ''; el.animating = false; };
    animation.oncancel = () => { el.style.overflow = ''; el.style.height = ''; el.animating = false; };
  }

  if (!window.faqListenerAdded) {
    document.addEventListener('click', function (e) {
      const summary = e.target.closest('details.faq-animate > summary');
      if (!summary) return;
      e.preventDefault(); 
      const el = summary.parentElement;
      const content = el.querySelector('.faq-content');
      if (el.animating) return;
      if (el.open) { shrinkFaq(el, summary); } else { openFaq(el, summary, content); }
    });
    window.faqListenerAdded = true;
  }
</script>


{% schema %}
{
  "name": "DRBERG FAQ META HOME",
  "tag": "section",
  "class": "section-faq",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Frequently Asked Questions",
      "label": "Heading"
    },
    {
      "type": "checkbox",
      "id": "hide_categories",
      "label": "Спрятать названия категорий",
      "default": false,
      "info": "Включите для главной страницы, чтобы выводить просто список вопросов"
    },  
    {
      "type": "header",
      "content": "Questions Output"
    },
    {
      "type": "checkbox",
      "id": "homepage_mode",
      "label": "Режим главной страницы (только избранные)",
      "default": false,
      "info": "Выводить только вопросы, у которых в базе стоит галочка 'Show on Homepage'"
    },
    {
      "type": "range",
      "id": "questions_limit",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 0,
      "unit": "qs",
      "label": "Limit questions",
      "info": "0 = Show all questions. Use 5-7 for Homepage."
    },
    {
      "type": "header",
      "content": "More FAQ Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "default": "More FAQ",
      "label": "Button Text"
    },
    {
      "type": "page",
      "id": "faq_page",
      "label": "Select FAQ Page"
    },
    {
      "type": "header",
      "content": "🖥️ Desktop (≥ 1024px)"
    },
        {
      "type": "header",
      "content": "Reviews Statistics"
    },
    {
      "type": "text",
      "id": "rating_score",
      "default": "4.8",
      "label": "Average rating score"
    },
    {
      "type": "text",
      "id": "review_count",
      "default": "2,847",
      "label": "Total number of reviews"
    },
    {
      "type": "range", "id": "gap_categories_desktop", "min": 0, "max": 10, "step": 0.5, "default": 2.5, "unit": "rem", "label": "Gap between categories"
    },
    {
      "type": "range", "id": "gap_items_desktop", "min": 0, "max": 5, "step": 0.5, "default": 2.5, "unit": "rem", "label": "Gap between items"
    },
    {
      "type": "range", "id": "padding_top_desktop", "min": 0, "max": 20, "step": 0.5, "default": 8, "unit": "rem", "label": "Padding top"
    },
    {
      "type": "range", "id": "padding_bottom_desktop", "min": 0, "max": 20, "step": 0.5, "default": 8, "unit": "rem", "label": "Padding bottom"
    },
    {
      "type": "header",
      "content": "💻 Tablet (640px - 1024px)"
    },
    {
      "type": "range", "id": "gap_categories_tablet", "min": 0, "max": 8, "step": 0.5, "default": 2, "unit": "rem", "label": "Gap between categories"
    },
    {
      "type": "range", "id": "gap_items_tablet", "min": 0, "max": 4, "step": 0.5, "default": 2, "unit": "rem", "label": "Gap between items"
    },
    {
      "type": "range", "id": "padding_top_tablet", "min": 0, "max": 15, "step": 0.5, "default": 5, "unit": "rem", "label": "Padding top"
    },
    {
      "type": "range", "id": "padding_bottom_tablet", "min": 0, "max": 15, "step": 0.5, "default": 5, "unit": "rem", "label": "Padding bottom"
    },
    {
      "type": "header",
      "content": "📱 Mobile (< 640px)"
    },
    {
      "type": "range", "id": "gap_categories_mobile", "min": 0, "max": 5, "step": 0.5, "default": 1.5, "unit": "rem", "label": "Gap between categories"
    },
    {
      "type": "range", "id": "gap_items_mobile", "min": 0, "max": 3, "step": 0.5, "default": 1.5, "unit": "rem", "label": "Gap between items"
    },
    {
      "type": "range", "id": "padding_top_mobile", "min": 0, "max": 10, "step": 0.5, "default": 3, "unit": "rem", "label": "Padding top"
