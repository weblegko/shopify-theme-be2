      "label": "Initial items to show"
    },
    {
      "type": "range",
      "id": "col_gap_tablet",
      "min": 0,
      "max": 4,
      "step": 0.5,
      "default": 2,
      "unit": "rem",
      "label": "Column gap"
    },
    {
      "type": "range",
      "id": "row_gap_tablet",
      "min": 0,
      "max": 4,
      "step": 0.5,
      "default": 2,
      "unit": "rem",
      "label": "Row gap (vertical)"
    },
    {
      "type": "range",
      "id": "padding_top_tablet",
      "min": 0,
      "max": 15,
